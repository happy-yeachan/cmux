def parse_agents(agents_str: str) -> dict[str, str]:
    """Parse 'role=agent,role=agent' into dict."""
    result = {}
    for pair in agents_str.split(","):
        pair = pair.strip()
        if "=" in pair:
            role, agent = pair.split("=", 1)
            result[role.strip()] = agent.strip()
        else:
            raise ValueError(
                f"Invalid agent spec '{pair}'. Expected 'role=agent' "
                f"(e.g., frontend=claude-code)"
            )
    return result


async def run(args: argparse.Namespace) -> None:
    phases: list[dict] | None = None

    if args.mock:
        agents = DEFAULT_MOCK_AGENTS
        log("mode: mock", DIM)
    elif args.agents:
        agents = parse_agents(args.agents)
        log("mode: manual assignment", DIM)
    else:
        # ── Auto mode: AI planning with keyword fallback ──
        available = detect_available_agents()
        plan = ai_plan_task(args.task, available)

        if plan and "phases" in plan:
            phases = plan["phases"]
            log("mode: AI-planned (phased)", GREEN)

            # Collect all agents from phases
            agents = {}
            W = 62
            print(f"\n{DIM}{'─' * W}{RESET}")
            print(f"{BOLD}{CYAN}  AI PLAN  {RESET}{DIM}(main agent: claude){RESET}")
            print(f"{DIM}{'─' * W}{RESET}")

            for pi, phase in enumerate(phases):
                pname = phase.get("name", f"phase-{pi+1}")
                tasks = phase.get("tasks", [])
                print(f"\n  {BOLD}Phase {pi+1}: {pname}{RESET}  ({len(tasks)} tasks, parallel)")
                for t in tasks:
                    role = t.get("role", "?")
                    agent = t.get("agent", "?")
                    prompt = t.get("prompt", "")
                    agents[role] = agent
                    snippet = prompt[:90].replace("\n", " ")
                    print(f"    {BOLD}{role}{RESET} → {agent}")
                    print(f"      {DIM}{snippet}{'...' if len(prompt) > 90 else ''}{RESET}")

            print(f"\n{DIM}{'─' * W}{RESET}\n")
        else:
            # Fallback to keyword-based planning with proper phasing
            log("mode: keyword auto-plan (AI unavailable)", YELLOW)
            roles = analyze_task_roles(args.task)
            agents = assign_agents(roles, available)
            print_auto_plan(args.task, available, roles, agents)

            # Build phased plan: implement tasks first, then review
            impl_roles = {r: a for r, a in agents.items() if r != "review"}
            review_roles = {r: a for r, a in agents.items() if r == "review"}

            phases = []
            if impl_roles:
                phases.append({
                    "name": "implement",
                    "tasks": [{"role": r, "agent": a, "prompt": ""} for r, a in impl_roles.items()],
                })
            if review_roles:
                phases.append({
                    "name": "review",
                    "tasks": [{"role": r, "agent": a, "prompt": ""} for r, a in review_roles.items()],
                })

    session = OrchestrateSession(
        task=args.task,
        agents=agents,
        cwd=args.cwd,
    )
    if phases:
        session._phases = phases
        # Build ai_prompts from phases
        for phase in phases:
            for t in phase.get("tasks", []):
                session._ai_prompts[t["role"]] = t.get("prompt", "")

    try:
        # Step 1: Start broker
        session.start_broker()

        # Step 2+3+4: Phased execution (create panes → launch → dispatch → collect → close per phase)
        await session.run_phased()

        # AI synthesis of results
        usable_results = {r: v for r, v in session._results.items() if not v.startswith("[ERROR]")}
        if usable_results and not args.mock:
            synthesis = ai_synthesize(args.task, usable_results, agents)
            if synthesis:
                session._synthesis = synthesis

        # Print summary
        session.print_summary()

    except KeyboardInterrupt:
        log("interrupted", YELLOW)
    except Exception as e:
        log(f"error: {e}", RED)
        raise
    finally:
        session.cleanup()


def main() -> None:
    parser = argparse.ArgumentParser(
        description="cmux orchestrate — Multi-Agent Orchestrator",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Auto mode: detect installed agents, assign roles automatically
  cmux-orchestrate --task "Build a login page with OAuth"

  # Manual override
  cmux-orchestrate --task "Build a dashboard" \\
      --agents frontend=claude-code,backend=codex,review=gemini-cli

  # Mock mode (testing/demo)
  cmux-orchestrate --task "Build a dashboard" --mock
        """,
    )
    parser.add_argument(
        "--task", required=True,
        help="The task to distribute across agents"
    )
    parser.add_argument(
        "--agents", default="",
        help="Agent assignments: role=agent,... "
             "(e.g., frontend=claude-code,backend=codex,review=gemini-cli)"
    )
    parser.add_argument(
        "--mock", action="store_true",
        help="Use mock agents (for testing/demo)"
    )
    parser.add_argument(
        "--cwd", default=None,
        help="Working directory for agents (default: current directory)"
    )
    parser.add_argument(
        "--socket", default=None,
        help="Broker socket path (default: /tmp/cmux-orchestrate.sock)"
    )

    args = parser.parse_args()

    # No error if neither --agents nor --mock: auto mode kicks in

    if args.socket:
        global SOCKET_PATH
        SOCKET_PATH = args.socket

    banner()
    log(f"task: {args.task}", WHITE)
    if args.mock:
        log(f"agents: mock (frontend, backend, review)", WHITE)
    elif args.agents:
        log(f"agents: {args.agents}", WHITE)
    else:
        log(f"agents: auto-detect", CYAN)
    log(f"cwd: {args.cwd or os.getcwd()}", DIM)
    print()

    asyncio.run(run(args))


if __name__ == "__main__":
    main()
