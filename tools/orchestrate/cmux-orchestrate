#!/usr/bin/env python3
"""
cmux orchestrate — Multi-Agent Orchestrator

Spawns multiple AI agent workers (claude-code, codex, gemini-cli) in
cmux split panes, coordinates them via an IPC broker, and collects
results.

Usage:
    cmux-orchestrate --task "Build a login page" \\
        --agents frontend=claude-code,backend=codex,review=gemini-cli

    cmux-orchestrate --task "Refactor auth module" --mock

    cmux-orchestrate --task "Add unit tests" \\
        --agents tests=claude-code,review=gemini-cli
"""

import argparse
import asyncio
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

# ── ANSI colors ──────────────────────────────────────────────────────
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
CYAN = "\033[36m"
WHITE = "\033[37m"

SCRIPT_DIR = Path(__file__).resolve().parent
SOCKET_PATH = os.environ.get(
    "CMUX_ORCHESTRATE_SOCK", "/tmp/cmux-orchestrate.sock"
)

# Default agent assignment when --mock is used
DEFAULT_MOCK_AGENTS = {
    "frontend": "mock",
    "backend": "mock",
    "review": "mock",
}


def log(msg: str, color: str = DIM) -> None:
    ts = time.strftime("%H:%M:%S")
    print(
        f"{DIM}{ts}{RESET} {BOLD}{MAGENTA}[orchestrate]{RESET} {color}{msg}{RESET}",
        flush=True,
    )


def banner() -> None:
    print(f"""
{BOLD}{MAGENTA}╔══════════════════════════════════════════════════════╗
║                                                      ║
║   {CYAN}cmux orchestrate{MAGENTA}  —  Multi-Agent Orchestrator     ║
