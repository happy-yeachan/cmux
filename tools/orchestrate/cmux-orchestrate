def detect_available_agents() -> list[dict]:
    """Detect which agent CLIs are installed on the system."""
    available = []
    for agent in AGENT_REGISTRY:
        for cmd in agent["commands"]:
            if shutil.which(cmd):
                available.append(agent)
                break
    return available


def analyze_task_roles(task: str) -> list[str]:
    """Analyze a task description and determine which roles are needed."""
    task_lower = task.lower()
    role_scores: dict[str, int] = {}

    for role, keywords in ROLE_KEYWORDS.items():
        score = sum(1 for kw in keywords if kw in task_lower)
        if score > 0:
            role_scores[role] = score

    # Always include review if we have 2+ other roles
    if not role_scores:
        # Generic task: default to frontend + backend + review
        return ["frontend", "backend", "review"]

    roles = sorted(role_scores, key=lambda r: role_scores[r], reverse=True)

    # Cap at 4 roles max, ensure review is included for quality
    if "review" not in roles:
        roles.append("review")
    return roles[:4]


def assign_agents(roles: list[str], available: list[dict]) -> dict[str, str]:
    """Assign the best available agent to each role."""
    if not available:
        # No agents found — fall back to mock
        return {role: "mock" for role in roles}

    assignments: dict[str, str] = {}
    used_agents: set[str] = set()

    for role in roles:
        best_agent = None
        best_score = -1

        for agent in available:
            # Score: how many of this agent's strengths match the role
            score = 10 if role in agent["strengths"] else 0
            # Prefer agents not yet assigned (diversity)
            if agent["name"] not in used_agents:
                score += 5
            # Priority tiebreaker (lower = better)
            score -= agent["priority"]

            if score > best_score:
                best_score = score
                best_agent = agent

        if best_agent:
            assignments[role] = best_agent["name"]
            used_agents.add(best_agent["name"])

    return assignments


def auto_plan(task: str) -> dict[str, str]:
    """Full auto: detect agents, analyze task, assign roles."""
    available = detect_available_agents()
    roles = analyze_task_roles(task)
    assignments = assign_agents(roles, available)
    return assignments


