# ── AI-powered planning & synthesis (Main Agent = claude --print) ─────

def _call_claude(prompt: str, timeout: float = 120) -> str | None:
    """Call claude --print and return output. Returns None on failure."""
    cmd = ["claude", "--print", "--output-format", "text", "-p", prompt]
    master, slave = pty.openpty()
    try:
        proc = subprocess.Popen(
            cmd, stdout=slave, stderr=slave, stdin=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        os.close(master)
        os.close(slave)
        return None
    os.close(slave)

    chunks: list[bytes] = []
    deadline = time.time() + timeout
    while proc.poll() is None:
        remaining = deadline - time.time()
        if remaining <= 0:
            proc.kill()
            proc.wait()
            os.close(master)
            return None
        r, _, _ = select.select([master], [], [], min(remaining, 0.5))
        if r:
            try:
                chunks.append(os.read(master, 8192))
            except OSError:
                break
    # Drain
    while True:
        r, _, _ = select.select([master], [], [], 0.1)
        if not r:
            break
        try:
            data = os.read(master, 8192)
            if not data:
                break
            chunks.append(data)
        except OSError:
            break
    os.close(master)

    if proc.returncode != 0:
        return None
    text = b"".join(chunks).decode(errors="replace")
    text = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", text)
    text = re.sub(r"\x1b\].*?\x07", "", text)
    return text.strip()


def _extract_json(text: str) -> dict | None:
    """Extract a JSON object from text that may contain markdown fences."""
    # Try direct parse
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        pass
    # Try extracting from ```json ... ``` block
    m = re.search(r"```(?:json)?\s*\n?(.*?)\n?\s*```", text, re.DOTALL)
    if m:
        try:
            return json.loads(m.group(1))
        except json.JSONDecodeError:
            pass
    # Try finding first { ... } block
    depth = 0
    start = None
    for i, ch in enumerate(text):
        if ch == "{":
            if depth == 0:
                start = i
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0 and start is not None:
                try:
                    return json.loads(text[start : i + 1])
                except json.JSONDecodeError:
                    start = None
    return None


def ai_plan_task(task: str, available_agents: list[dict]) -> dict | None:
    """Use claude as main agent to decompose task into phased plan.

    Returns dict like:
      {
        "phases": [
          {
            "name": "implement",
            "tasks": [
              {"role": "backend-auth", "agent": "codex", "prompt": "..."},
              {"role": "frontend", "agent": "claude-code", "prompt": "..."}
            ]
          },
          {
            "name": "review",
            "tasks": [
              {"role": "review", "agent": "gemini-cli", "prompt": "..."}
            ]
          }
        ]
      }
    Or None if AI planning fails.
    """
    agent_descriptions = "\n".join(
        f"  - {a['name']}: {a['description']} (strengths: {', '.join(a['strengths'])})"
        for a in available_agents
    )

    prompt = f"""You are the orchestrator for a multi-agent coding system.

AVAILABLE AGENTS:
{agent_descriptions}

TASK:
{task}

Decompose this task into PHASES. Within each phase, tasks run in parallel. Phases run sequentially — later phases can depend on earlier phase results.

Rules:
- Choose only from the available agents listed above. You may assign the same agent to multiple tasks.
- Each role name should be a short, unique lowercase identifier (e.g., backend-auth, backend-db, frontend-ui, review).
- The last phase should always be "review" — it reviews all prior phase outputs.
- Write prompts that are specific to THIS task, not generic templates.
- Review prompts should reference what the earlier phases are doing.
- Max 6 tasks total across all phases.

Respond with ONLY a JSON object (no markdown, no explanation):
{{"phases": [{{"name": "...", "tasks": [{{"role": "...", "agent": "...", "prompt": "..."}}]}}]}}"""

    log("main agent (claude) analyzing task...", CYAN)
    start = time.time()
    result = _call_claude(prompt, timeout=120)
    elapsed = time.time() - start

    if not result:
        log(f"main agent failed ({elapsed:.1f}s) — falling back to keyword plan", RED)
        return None

    log(f"main agent responded ({elapsed:.1f}s)", GREEN)
    parsed = _extract_json(result)
    if not parsed or "phases" not in parsed:
        # Try legacy "roles" format and auto-wrap in phases
        if parsed and "roles" in parsed:
            impl_tasks = [t for t in parsed["roles"] if t.get("role") != "review"]
            review_tasks = [t for t in parsed["roles"] if t.get("role") == "review"]
            parsed = {"phases": []}
            if impl_tasks:
                parsed["phases"].append({"name": "implement", "tasks": impl_tasks})
            if review_tasks:
                parsed["phases"].append({"name": "review", "tasks": review_tasks})
        else:
            log(f"main agent returned invalid JSON — falling back", RED)
            log(f"  raw: {result[:200]}", DIM)
            return None

    return parsed


def ai_synthesize(task: str, results: dict[str, str], agents: dict[str, str]) -> str | None:
    """Use claude to synthesize all agent results into a unified analysis."""
    results_text = ""
    for role, output in results.items():
        agent = agents.get(role, "unknown")
        truncated = output[:3000]
        results_text += f"\n--- {role} ({agent}) ---\n{truncated}\n"

    prompt = f"""You are reviewing the outputs of a multi-agent coding task.

ORIGINAL TASK: {task}

AGENT RESULTS:
{results_text}

Analyze the combined results and provide:
1. **Summary**: What was accomplished by each agent (1-2 sentences each)
2. **Integration issues**: Do the outputs conflict? (e.g., mismatched API contracts, incompatible assumptions)
3. **Gaps**: What's missing that no agent addressed?
4. **Verdict**: Is the task complete, partially complete, or failed?

Be specific and concise."""

    log("main agent synthesizing results...", CYAN)
    start = time.time()
    result = _call_claude(prompt, timeout=120)
    elapsed = time.time() - start

    if not result:
        log(f"synthesis failed ({elapsed:.1f}s)", RED)
        return None

    log(f"synthesis complete ({elapsed:.1f}s)", GREEN)
    return result


