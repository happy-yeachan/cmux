#!/usr/bin/env bash
set -euo pipefail

# ── cmux orchestrate ─────────────────────────────────────────────────
# Multi-agent orchestrator. Splits cmux panes, runs AI agents in each,
# collects results via capture files, passes context between phases.
#
# Usage:
#   cmux-orchestrate --task "Build a dashboard" --cwd ~/projects/app
#   cmux-orchestrate --task "Build a dashboard" --mock
# ─────────────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGENTS_JSON="${CMUX_ORCHESTRATE_AGENTS:-$SCRIPT_DIR/agents.json}"
CAPTURE_DIR="/tmp/cmux-orchestrate-$$"

# ── Colors ───────────────────────────────────────────────────────────
RST="\033[0m"; BOLD="\033[1m"; DIM="\033[2m"
RED="\033[31m"; GRN="\033[32m"; YLW="\033[33m"
BLU="\033[34m"; MAG="\033[35m"; CYN="\033[36m"

log() { printf "${DIM}%s${RST} ${BOLD}${MAG}[orchestrate]${RST} %b${RST}\n" "$(date +%H:%M:%S)" "$1"; }
err() { log "${RED}$1"; }

# ── CLI Args ─────────────────────────────────────────────────────────
TASK="" CWD="" MOCK=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --task)  TASK="$2"; shift 2 ;;
        --cwd)   CWD="$2"; shift 2 ;;
        --mock)  MOCK=true; shift ;;
        --help)
            echo "Usage: cmux-orchestrate --task <task> [--cwd <dir>] [--mock]"
            echo "  --task   Task description (required)"
            echo "  --cwd    Working directory for agents (default: current dir)"
            echo "  --mock   Run mock agents (testing)"
            exit 0 ;;
        *) echo "Unknown arg: $1"; exit 1 ;;
    esac
done

[[ -z "$TASK" ]] && { echo "Error: --task is required"; exit 1; }
CWD="${CWD:-$(pwd)}"
mkdir -p "$CWD" "$CAPTURE_DIR"

# ── Banner ───────────────────────────────────────────────────────────
printf "\n${BOLD}${MAG}"
echo "╔══════════════════════════════════════════════════════╗"
echo "║                                                      ║"
echo "║   cmux orchestrate  —  Multi-Agent Orchestrator      ║"
echo "║                                                      ║"
echo "╚══════════════════════════════════════════════════════╝"
printf "${RST}\n"

log "task: ${BOLD}$TASK${RST}"
log "cwd:  ${DIM}$CWD${RST}"

# ── Load agents.json ─────────────────────────────────────────────────
AVAILABLE_AGENTS=()

if [[ -f "$AGENTS_JSON" ]]; then
    while IFS= read -r name; do
        AVAILABLE_AGENTS+=("$name")
    done < <(jq -r '.[]' "$AGENTS_JSON" 2>/dev/null)
    log "agents: ${BOLD}${AVAILABLE_AGENTS[*]}${RST}"
else
    err "agents.json not found at $AGENTS_JSON"
    exit 1
fi

# ── Agent command builder ────────────────────────────────────────────
# Internal knowledge: how to run each agent CLI.
# Users never see this — they just list names in agents.json.
build_agent_cmd() {
    local agent="$1" prompt_file="$2"
    case "$agent" in
        claude-code)
            # Pipe prompt + /exit so claude processes then quits.
            # User sees interactive TUI while it works, then it exits cleanly.
            echo "(cat $(printf '%q' "$prompt_file"); echo; echo '/exit') | claude --dangerously-skip-permissions" ;;
        codex)
            echo "codex \"\$(cat $(printf '%q' "$prompt_file"))\"" ;;
        gemini-cli)
            echo "gemini -p \"\$(cat $(printf '%q' "$prompt_file"))\" -y" ;;
        *)
            echo "$agent < $(printf '%q' "$prompt_file")" ;;
    esac
}

# ── cmux helpers ─────────────────────────────────────────────────────
cmux_split() {
    local direction="$1" surface="${2:-}"
    local args="--json new-split"
    [[ -n "$surface" ]] && args="$args --surface $surface"
    args="$args $direction"
    local out
    out=$(cmux $args 2>/dev/null) || return 1
    echo "$out" | jq -r '.surface_ref // .surface_id // empty' 2>/dev/null
}

cmux_send() {
    local surface="$1" text="$2"
    cmux send --surface "$surface" -- "${text}\\n" >/dev/null 2>&1
}

cmux_close() {
    local surface="$1"
    cmux close-surface --surface "$surface" >/dev/null 2>&1 || true
}

# Run a command in a cmux pane (interactive, visible to user).
# Creates a pane, runs the command via script capture, waits, collects output, closes pane.
# Usage: result=$(run_in_pane "label" "command" "prompt_text")
run_in_pane() {
    local label="$1" agent_cmd="$2" prompt_text="$3"
    local sid capture prompt_file

    # Create pane
    sid=$(cmux_split "right") || { err "failed to create pane for $label"; return 1; }
    log "  ${BOLD}[$label]${RST} pane → $sid"

    # Write prompt to file
    prompt_file="$CAPTURE_DIR/prompt-${label}.txt"
    printf '%s' "$prompt_text" > "$prompt_file"

    # Build full command with prompt file
    capture="$CAPTURE_DIR/capture-${label}.log"
    local full_cmd
    full_cmd=$(echo "$agent_cmd" | sed "s|__PROMPT_FILE__|${prompt_file}|g")

    # Send to pane
    cmux_send "$sid" "script -q $(printf '%q' "$capture") bash -c $(printf '%q' "$full_cmd")"

    # Wait for capture file to appear
    local wait_count=0
    while [[ ! -f "$capture" ]] && [[ $wait_count -lt 30 ]]; do
        sleep 1; wait_count=$((wait_count + 1))
    done

    # Wait for completion
    wait_for_completion "$capture" "$label"

    # Read result
    local result=""
    if [[ -f "$capture" ]]; then
        result=$(sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' "$capture" | tail -c 10000)
    fi

    # Close pane
    cmux_close "$sid"
    log "  ${GRN}[$label] done, pane closed${RST}"

    echo "$result"
}

# ── Wait for agent completion ────────────────────────────────────────
# No timeout. Polls capture file size. Stops when stable for 30s.
wait_for_completion() {
    local capture="$1" role="$2"
    local last_size=0 stall=0 elapsed=0

    while true; do
        sleep 5
        elapsed=$((elapsed + 5))
        local size
        size=$(stat -f%z "$capture" 2>/dev/null || echo 0)

        if [[ "$size" -gt "$last_size" ]]; then
            stall=0
            local delta=$((size - last_size))
            log "  ${DIM}[$role] active (+${delta}B, ${elapsed}s)${RST}"
            last_size=$size
        else
            stall=$((stall + 1))
            # 30s (6 checks) of no activity → done
            if [[ "$stall" -ge 6 ]]; then
                log "  ${GRN}[$role] completed (${elapsed}s)${RST}"
                return 0
            fi
        fi
    done
}

# ── AI Planning ──────────────────────────────────────────────────────
# Ask main agent to decompose task into phased plan.
# Returns JSON in PLAN_JSON variable, or empty on failure.
PLAN_JSON=""

ai_plan() {
    local agent_list
    agent_list=$(printf '%s, ' "${AVAILABLE_AGENTS[@]}")
    agent_list="${agent_list%, }"

    local prompt="You are the orchestrator for a multi-agent coding system.

AVAILABLE AGENTS: ${agent_list}

You know each agent's capabilities. Assign the best agent for each sub-task.

TASK:
${TASK}

Decompose this task into PHASES. Within each phase, tasks run in parallel. Phases run sequentially.

Rules:
- Choose only from the available agents listed above.
- Each role name should be a short unique lowercase identifier (e.g., backend-auth, frontend-ui, review).
- The last phase should always be \"review\".
- Write prompts that are specific to THIS task. Tell agents to use sensible defaults and NOT ask clarifying questions.
- Tell agents to create real files in the current working directory.
- Max 6 tasks total across all phases.

Respond with ONLY a JSON object:
{\"phases\": [{\"name\": \"...\", \"tasks\": [{\"role\": \"...\", \"agent\": \"...\", \"prompt\": \"...\"}]}]}"

    log "${CYN}main agent analyzing task (interactive)...${RST}"
    local start=$SECONDS
    local result
    # Run main agent in a visible cmux pane
    result=$(run_in_pane "planner" "(cat __PROMPT_FILE__; echo; echo '/exit') | claude --dangerously-skip-permissions" "$prompt") || {
        err "main agent failed"
        return 1
    }
    local elapsed=$((SECONDS - start))
    log "${GRN}main agent responded (${elapsed}s)${RST}"

    # Extract JSON from response
    PLAN_JSON=$(echo "$result" | sed -n '/^{/,/^}/p' | head -100)
    if ! echo "$PLAN_JSON" | jq . >/dev/null 2>&1; then
        # Try extracting from markdown code block
        PLAN_JSON=$(echo "$result" | sed -n '/```json/,/```/p' | sed '1d;$d')
        if ! echo "$PLAN_JSON" | jq . >/dev/null 2>&1; then
            err "failed to parse AI plan"
            PLAN_JSON=""
            return 1
        fi
    fi
}

# ── Keyword Fallback ─────────────────────────────────────────────────
# When AI planner fails. Determines roles from keywords,
# assigns agents from agents.json (round-robin, NOT hardcoded).
keyword_fallback() {
    local task_lower
    task_lower=$(echo "$TASK" | tr '[:upper:]' '[:lower:]')

    local roles=()
    echo "$task_lower" | grep -qE 'ui|page|dashboard|frontend|component|react|vue|css|html' && roles+=("frontend")
    echo "$task_lower" | grep -qE 'api|backend|server|database|endpoint|auth|rest|graphql|login|oauth' && roles+=("backend")
    echo "$task_lower" | grep -qE 'test|spec|coverage|e2e|unit' && roles+=("test")
    echo "$task_lower" | grep -qE 'deploy|ci|cd|docker|kubernetes|terraform' && roles+=("devops")
    echo "$task_lower" | grep -qE 'document|readme|changelog' && roles+=("docs")

    # Default if no keywords matched
    [[ ${#roles[@]} -eq 0 ]] && roles=("frontend" "backend")

    # Always add review
    roles+=("review")

    # Assign agents from available list (round-robin)
    local num_agents=${#AVAILABLE_AGENTS[@]}
    local impl_tasks="" review_tasks=""
    local i=0

    for role in "${roles[@]}"; do
        local agent="${AVAILABLE_AGENTS[$((i % num_agents))]}"
        local prompt
        case "$role" in
            frontend) prompt="You are the frontend specialist. Implement the UI/frontend parts of this task.\n\nTask: ${TASK}\n\nIMPORTANT: Do NOT ask clarifying questions. Use sensible defaults and start building immediately. Create real files in the current working directory." ;;
            backend)  prompt="You are the backend specialist. Implement the backend/logic parts of this task.\n\nTask: ${TASK}\n\nIMPORTANT: Do NOT ask clarifying questions. Use sensible defaults and start building immediately. Create real files in the current working directory." ;;
            review)   prompt="You are the code reviewer. Review ALL files in the current working directory.\n\nTask: ${TASK}\n\nList specific issues found with file paths and line numbers." ;;
            test)     prompt="You are the test engineer. Write tests for this task.\n\nTask: ${TASK}\n\nCreate real test files in the current working directory." ;;
            devops)   prompt="You are the DevOps specialist. Set up infrastructure.\n\nTask: ${TASK}\n\nCreate Dockerfile, CI config, etc. in the current working directory." ;;
            docs)     prompt="You are the documentation specialist. Write documentation.\n\nTask: ${TASK}\n\nCreate README and docs in the current working directory." ;;
            *)        prompt="Handle the ${role} parts of: ${TASK}" ;;
        esac

        local entry
        entry=$(jq -n --arg r "$role" --arg a "$agent" --arg p "$prompt" \
            '{role: $r, agent: $a, prompt: $p}')

        if [[ "$role" == "review" ]]; then
            review_tasks="${review_tasks}${review_tasks:+,}${entry}"
        else
            impl_tasks="${impl_tasks}${impl_tasks:+,}${entry}"
            i=$((i + 1))
        fi
    done

    # Build phased plan: implement → review
    PLAN_JSON="{\"phases\":["
    [[ -n "$impl_tasks" ]] && PLAN_JSON="${PLAN_JSON}{\"name\":\"implement\",\"tasks\":[${impl_tasks}]},"
    [[ -n "$review_tasks" ]] && PLAN_JSON="${PLAN_JSON}{\"name\":\"review\",\"tasks\":[${review_tasks}]}"
    PLAN_JSON="${PLAN_JSON}]}"

    log "${YLW}keyword fallback plan:${RST}"
    echo "$PLAN_JSON" | jq -r '.phases[] | "  Phase: \(.name) → \([.tasks[].role] | join(", "))"'
}

# ���─ Mock agent ───────────────────────────────────────────────────────
run_mock_phase() {
    local phase_json="$1"
    local num_tasks
    num_tasks=$(echo "$phase_json" | jq '.tasks | length')

    for ((i=0; i<num_tasks; i++)); do
        local role agent prompt
        role=$(echo "$phase_json" | jq -r ".tasks[$i].role")
        agent=$(echo "$phase_json" | jq -r ".tasks[$i].agent")
        log "  ${DIM}[mock] $role ($agent): processing...${RST}"
        sleep 2
        echo "[${role}] Mock completed. Generated ${role} component." > "$CAPTURE_DIR/capture-${role}.log"
        log "  ${GRN}[mock] $role done${RST}"
    done
}

# ── Run a phase ──────────────────────────────────────────────────────
run_phase() {
    local phase_json="$1" phase_idx="$2" total_phases="$3" prev_context="$4"
    local phase_name
    phase_name=$(echo "$phase_json" | jq -r '.name')
    local num_tasks
    num_tasks=$(echo "$phase_json" | jq '.tasks | length')

    printf "\n${BOLD}${CYN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RST}\n"
    printf "${BOLD}${CYN}  PHASE %d/%d: %s${RST}\n" "$phase_idx" "$total_phases" "$(echo "$phase_name" | tr '[:lower:]' '[:upper:]')"
    printf "${BOLD}${CYN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RST}\n"

    # Mock mode
    if $MOCK; then
        run_mock_phase "$phase_json"
        return 0
    fi

    local surface_ids=()
    local roles=()
    local last_surface=""

    # Create panes
    log "creating $num_tasks panes..."
    for ((i=0; i<num_tasks; i++)); do
        local role
        role=$(echo "$phase_json" | jq -r ".tasks[$i].role")
        roles+=("$role")

        local sid
        if [[ $i -eq 0 ]]; then
            sid=$(cmux_split "right") || sid=""
        else
            sid=$(cmux_split "down" "$last_surface") || sid=""
        fi

        surface_ids+=("$sid")
        [[ -n "$sid" ]] && last_surface="$sid"
        log "  $role → ${sid:-FAILED}"
        sleep 0.3
    done

    # Launch agents in panes
    log "launching agents..."
    for ((i=0; i<num_tasks; i++)); do
        local role agent prompt sid
        role=$(echo "$phase_json" | jq -r ".tasks[$i].role")
        agent=$(echo "$phase_json" | jq -r ".tasks[$i].agent")
        prompt=$(echo "$phase_json" | jq -r ".tasks[$i].prompt")
        sid="${surface_ids[$i]}"

        # Append previous phase context
        if [[ -n "$prev_context" ]]; then
            prompt="${prompt}

--- CONTEXT FROM PREVIOUS PHASES ---
${prev_context}"
        fi

        # Write prompt to file (agents read from this)
        local prompt_file="$CAPTURE_DIR/prompt-${role}.txt"
        printf '%s' "$prompt" > "$prompt_file"

        local capture="$CAPTURE_DIR/capture-${role}.log"
        local agent_cmd
        agent_cmd=$(build_agent_cmd "$agent" "$prompt_file")

        log "  ${BOLD}[$role]${RST} $agent → $sid"

        if [[ -n "$sid" ]]; then
            cmux_send "$sid" "cd $(printf '%q' "$CWD") && script -q $(printf '%q' "$capture") bash -c $(printf '%q' "$agent_cmd")"
        fi
    done

    # Wait for all agents to complete
    log "waiting for agents (no timeout)..."
    for ((i=0; i<num_tasks; i++)); do
        local role="${roles[$i]}"
        local capture="$CAPTURE_DIR/capture-${role}.log"

        # Wait for capture file to appear
        local wait=0
        while [[ ! -f "$capture" ]] && [[ $wait -lt 30 ]]; do
            sleep 1; wait=$((wait + 1))
        done

        wait_for_completion "$capture" "$role" &
    done
    wait  # Wait for all background wait_for_completion jobs

    # Collect results
    log "${GRN}all agents completed${RST}"

    # Close panes
    for ((i=0; i<num_tasks; i++)); do
        local sid="${surface_ids[$i]}"
        [[ -n "$sid" ]] && cmux_close "$sid"
    done
    log "panes closed"
}

# ── Collect context from phase results ───────────────────────────────
collect_context() {
    local context=""
    for f in "$CAPTURE_DIR"/capture-*.log; do
        [[ -f "$f" ]] || continue
        local role
        role=$(basename "$f" .log | sed 's/capture-//')
        local content
        content=$(cat "$f" | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | tail -c 5000)
        context="${context}
[$role] output:
${content}
"
    done

    # Add project file listing
    local files
    files=$(find "$CWD" -type f -maxdepth 4 \
        -not -path "*/node_modules/*" \
        -not -path "*/.git/*" \
        -not -path "*/__pycache__/*" 2>/dev/null | head -50)
    if [[ -n "$files" ]]; then
        context="${context}
[project files in $CWD]:
${files}
"
    fi

    echo "$context"
}

# ── Print report ─────────────────────────────────────────────────────
print_report() {
    local W=62
    printf "\n${BOLD}$( printf '═%.0s' $(seq 1 $W) )${RST}\n"
    printf "${BOLD}${MAG}  ORCHESTRATION REPORT${RST}\n"
    printf "${BOLD}$( printf '═%.0s' $(seq 1 $W) )${RST}\n\n"

    printf "  ${BOLD}Task:${RST}  %s\n" "$TASK"
    printf "  ${BOLD}CWD:${RST}   %s\n\n" "$CWD"

    for f in "$CAPTURE_DIR"/capture-*.log; do
        [[ -f "$f" ]] || continue
        local role
        role=$(basename "$f" .log | sed 's/capture-//')
        local size
        size=$(stat -f%z "$f" 2>/dev/null || echo 0)
        local snippet
        snippet=$(cat "$f" | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | tail -5 | head -3)

        printf "  ${BOLD}${CYN}── %s (%s chars) ──${RST}\n" "$role" "$size"
        echo "$snippet" | while IFS= read -r line; do
            printf "  │ %s\n" "$line"
        done
        echo ""
    done

    # Project files created
    local files
    files=$(find "$CWD" -type f -maxdepth 3 \
        -not -path "*/node_modules/*" -not -path "*/.git/*" 2>/dev/null | head -20)
    if [[ -n "$files" ]]; then
        printf "  ${BOLD}${GRN}── Files Created ──${RST}\n"
        echo "$files" | while IFS= read -r f; do
            printf "  │ %s\n" "$f"
        done
        echo ""
    fi

    printf "${BOLD}$( printf '═%.0s' $(seq 1 $W) )${RST}\n\n"
}

# ── Main ─────────────────────────────────────────────────────────────
main() {
    # Step 1: Plan
    if ! $MOCK; then
        ai_plan || {
            log "${YLW}AI planning failed — using keyword fallback${RST}"
            keyword_fallback
        }
    else
        log "mode: mock"
        keyword_fallback
    fi

    [[ -z "$PLAN_JSON" ]] && { err "no plan generated"; exit 1; }

    # Print plan
    log "${CYN}plan:${RST}"
    echo "$PLAN_JSON" | jq -r '.phases[] | "  Phase: \(.name) → \([.tasks[] | "\(.role)=\(.agent)"] | join(", "))"'
    echo ""

    # Step 2: Execute phases — main agent decides next phase after each one
    local num_phases
    num_phases=$(echo "$PLAN_JSON" | jq '.phases | length')
    local prev_context=""
    local phase_count=0

    for ((p=0; p<num_phases; p++)); do
        local phase_json
        phase_json=$(echo "$PLAN_JSON" | jq ".phases[$p]")
        phase_count=$((phase_count + 1))

        run_phase "$phase_json" "$phase_count" "$num_phases" "$prev_context"

        # Collect context from this phase
        prev_context=$(collect_context)

        # After each phase (except the last), main agent reviews and decides next phase
        local remaining=$((num_phases - p - 1))
        if [[ $remaining -gt 0 ]] && ! $MOCK; then
            log "${CYN}main agent reviewing phase results...${RST}"

            local next_phase_json
            next_phase_json=$(echo "$PLAN_JSON" | jq ".phases[$((p + 1))]")
            local next_name
            next_name=$(echo "$next_phase_json" | jq -r '.name')

            local agent_list
            agent_list=$(printf '%s, ' "${AVAILABLE_AGENTS[@]}")
            agent_list="${agent_list%, }"

            local review_prompt="You are the orchestrator for a multi-agent coding system.

AVAILABLE AGENTS: ${agent_list}

ORIGINAL TASK: ${TASK}

COMPLETED SO FAR:
${prev_context}

THE ORIGINAL PLAN says the next phase is \"${next_name}\" with these tasks:
$(echo "$next_phase_json" | jq -r '.tasks[] | "  - \(.role) (\(.agent)): \(.prompt[:100])..."')

Based on what was actually produced, do you want to:
1. PROCEED with the planned next phase as-is
2. MODIFY the next phase (change agents, prompts, or roles)
3. ADD an unplanned phase before continuing

Respond with ONLY a JSON object:
- To proceed: {\"action\": \"proceed\"}
- To modify:  {\"action\": \"modify\", \"phase\": {\"name\": \"...\", \"tasks\": [{\"role\": \"...\", \"agent\": \"...\", \"prompt\": \"...\"}]}}
- To add:     {\"action\": \"add\", \"phase\": {\"name\": \"...\", \"tasks\": [{\"role\": \"...\", \"agent\": \"...\", \"prompt\": \"...\"}]}}"

            local decision
            decision=$(run_in_pane "reviewer-p$((p+1))" "(cat __PROMPT_FILE__; echo; echo '/exit') | claude --dangerously-skip-permissions" "$review_prompt") || true

            # Parse decision
            local action_json
            action_json=$(echo "$decision" | sed -n '/^{/,/^}/p' | head -20)
            if ! echo "$action_json" | jq . >/dev/null 2>&1; then
                action_json=$(echo "$decision" | sed -n '/```json/,/```/p' | sed '1d;$d')
            fi

            local action
            action=$(echo "$action_json" | jq -r '.action // "proceed"' 2>/dev/null || echo "proceed")

            case "$action" in
                modify)
                    log "${YLW}main agent modified next phase${RST}"
                    local modified
                    modified=$(echo "$action_json" | jq '.phase' 2>/dev/null)
                    if echo "$modified" | jq . >/dev/null 2>&1; then
                        # Replace next phase in plan
                        PLAN_JSON=$(echo "$PLAN_JSON" | jq ".phases[$((p + 1))] = $modified")
                        echo "$modified" | jq -r '"  Modified → \(.name): \([.tasks[] | "\(.role)=\(.agent)"] | join(", "))"'
                    fi
                    ;;
                add)
                    log "${YLW}main agent added a new phase${RST}"
                    local new_phase
                    new_phase=$(echo "$action_json" | jq '.phase' 2>/dev/null)
                    if echo "$new_phase" | jq . >/dev/null 2>&1; then
                        # Insert new phase before the next planned one
                        PLAN_JSON=$(echo "$PLAN_JSON" | jq ".phases |= .[:$((p+1))] + [$new_phase] + .[$((p+1)):]")
                        num_phases=$((num_phases + 1))
                        echo "$new_phase" | jq -r '"  Added → \(.name): \([.tasks[] | "\(.role)=\(.agent)"] | join(", "))"'
                    fi
                    ;;
                *)
                    log "${GRN}main agent: proceed as planned${RST}"
                    ;;
            esac
        fi
    done

    # Step 3: Report
    print_report

    # Step 4: AI Synthesis (interactive, visible in pane)
    if ! $MOCK; then
        local all_context
        all_context=$(collect_context)
        if [[ -n "$all_context" ]]; then
            log "${CYN}main agent synthesizing results (interactive)...${RST}"
            local synth_prompt="You reviewed a multi-agent task.

TASK: ${TASK}

RESULTS:
${all_context}

Provide: 1) Summary of what each agent did 2) Integration issues 3) Gaps 4) Verdict (complete/partial/failed). Be concise."

            local synthesis
            synthesis=$(run_in_pane "synthesis" "(cat __PROMPT_FILE__; echo; echo '/exit') | claude --dangerously-skip-permissions" "$synth_prompt") || true

            if [[ -n "$synthesis" ]]; then
                printf "\n${BOLD}${MAG}── AI SYNTHESIS ──${RST}\n\n"
                echo "$synthesis" | while IFS= read -r line; do
                    printf "  %s\n" "$line"
                done
                echo ""
            fi
        fi
    fi

    # Cleanup
    rm -rf "$CAPTURE_DIR"
    log "${GRN}done${RST}"
}

main
